{
  "name": "ai-helper",
  "version": "0.1.0",
  "private": true,
  "description": "A Windows workspace for technical interview practice and permitted AI assistance",
  "author": "Soul-Eater69",
  "type": "module",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "eval:lld": "node scripts/eval-lld.mjs",
    "eval:compare": "node scripts/eval-compare.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "build": {
    "appId": "com.souleater.aihelper",
    "productName": "AI Helper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "AI-Helper-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "lucide-react": "1.47.0",
    "monaco-editor": "0.56.0",
    "openai": "7.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
